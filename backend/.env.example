# --- Database ---
# SQLite (zero-setup local dev):
DATABASE_URL=sqlite:///./jobpilot.db
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/jobpilot

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- AI (Groq) ---
# Get a key at https://console.groq.com/keys  (optional for MVP - heuristic fallback used otherwise)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Uploads ---
MAX_UPLOAD_MB=10

# --- Redis (caching + background jobs) ---
REDIS_URL=redis://localhost:6379/0

# --- Telegram (create a bot with @BotFather and paste the token) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=JobPilotAIBot

# --- Background agent ---
SCHEDULER_ENABLED=true
DEFAULT_SCAN_INTERVAL_MINUTES=60
DAILY_SUMMARY_HOUR=20
WEEKLY_REPORT_DAY=6
WEEKLY_REPORT_HOUR=20

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Job source anti-bot bypass (optional) ---
# Naukri (Akamai) and Wellfound (DataDome) block datacenter/headless IPs.
# Paste session cookies from a logged-in browser session ("name=value; n2=v2")
# and/or point SCRAPER_PROXY at a residential proxy to unblock them.
# LINKEDIN_COOKIES=
# WELLFOUND_COOKIES=
# NAUKRI_COOKIES=
# UNSTOP_COOKIES=
# SCRAPER_PROXY=

# --- Official job APIs (reliable, no scraping) ---
# Adzuna India needs a free key from https://developer.adzuna.com. Remotive is keyless.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

