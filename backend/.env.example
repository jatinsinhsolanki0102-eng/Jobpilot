# --- Database ---
# SQLite (zero-setup local dev):
DATABASE_URL=sqlite:///./jobpilot.db
# PostgreSQL (Neon free tier):
# DATABASE_URL=postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
# NOTE: Neon requires sslmode=require

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- AI (Groq) ---
# Get a key at https://console.groq.com/keys  (optional for MVP - heuristic fallback used otherwise)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Uploads ---
MAX_UPLOAD_MB=10

# --- Redis (caching + background jobs) ---
# Belmo Redis: rediss://default:password@host:port
REDIS_URL=redis://localhost:6379/0

# --- Telegram (create a bot with @BotFather and paste the token) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=JobPilotAIBot

# --- Background agent ---
SCHEDULER_ENABLED=true
DEFAULT_SCAN_INTERVAL_MINUTES=60
DAILY_SUMMARY_HOUR=20
WEEKLY_REPORT_DAY=6
WEEKLY_REPORT_HOUR=20

# --- CORS ---
# Add your Vercel frontend URL here (e.g., https://your-app.vercel.app)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Job source anti-bot bypass (optional) ---
# Naukri (Akamai) and Wellfound (DataDome) block datacenter/headless IPs.
# Paste session cookies from a logged-in browser session ("name=value; n2=v2")
# and/or point SCRAPER_PROXY at a residential proxy to unblock them.
# NOTE: cookies also need to be copied into the Belmo dashboard variables
# when deploying (they are not shipped in the Docker image).
# LINKEDIN_COOKIES=
# WELLFOUND_COOKIES=
# NAUKRI_COOKIES=
# UNSTOP_COOKIES=
# SCRAPER_PROXY=

# --- Official job APIs (reliable, no scraping) ---
# Adzuna India needs a free key from https://developer.adzuna.com. Remotive is keyless.
# IMPORTANT: on Belmo, add ADZUNA_APP_ID / ADZUNA_APP_KEY to the backend
# service variables as well - this file is not part of the deployment.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

